{
  "name": "gbmortise · 榫卯结构拆解图鉴",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:proof": "esbuild scripts/proof.e2e.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/proof.e2e.mjs --log-level=warning && node node_modules/.tmp/proof.e2e.mjs",
    "test:migration": "esbuild scripts/migration.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/migration.test.mjs --log-level=warning && node node_modules/.tmp/migration.test.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
